# Valores locales: npm run dev funciona SIN copiar este archivo.
PORT=5173
HOST=127.0.0.1
PUBLIC_ORIGIN=http://localhost:5173
NODE_ENV=development
DEMO_BOOKING=true
# Opcional. Por defecto se usa backend/data, siempre fuera de la carpeta pública.
DATA_DIR=
LEAD_RATE_LIMIT=30

# Producción: NODE_ENV=production, DEMO_BOOKING=false y PUBLIC_ORIGIN=https://tu-dominio.
# Calendly embebido funciona con la URL, sin token.
# Token y URI son opcionales y habilitan verificación adicional en el backend.
# Nunca se exponen los tokens al frontend.
CALENDLY_URL=https://calendly.com/rubengutierrezdv/new-meeting
CALENDLY_API_TOKEN=
CALENDLY_EVENT_TYPE_URI=
# Ejemplo de URI: https://api.calendly.com/event_types/UUID
# Configurar en Calendly: duración 45 min, Meet y ventana máxima de 2 días.

# Webhook opcional: recibe todas las respuestas y la reserva.
GHL_LEAD_WEBHOOK_URL=
GHL_WEBHOOK_TOKEN=
# Link HTTPS a los recursos gratuitos; si falta se muestra 'próximamente'.
RESOURCES_URL=
